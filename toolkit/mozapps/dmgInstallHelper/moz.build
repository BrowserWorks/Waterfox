with Files("**"):
    BUG_COMPONENT = ("Firefox", "Installer")

SPHINX_TREES["docs"] = "docs"

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    Program("org.mozilla.dmgInstallHelper")

    SOURCES = [
        "dmgInstallHelper.mm"
    ]

    OS_LIBS += [
            "-framework Cocoa",
            "-framework Security"
    ]

    CMMFLAGS += [
            "-fobjc-arc",
    ]

    LDFLAGS += [
            "-sectcreate",
            "__TEXT",
            "__info_plist",
            TOPOBJDIR + "/dist/bin/dmgInstallHelper-Info.plist",
            "-sectcreate",
            "__TEXT",
            "__launchd_plist",
            SRCDIR + "/Launchd.plist",
        ]

    EXPORTS += [
        "dmgInstallProtocol.h"
    ]
