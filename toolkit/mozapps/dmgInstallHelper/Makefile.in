include $(topsrcdir)/config/rules.mk

ifeq (cocoa,$(MOZ_WIDGET_TOOLKIT))
export::
	$(call py_action,preprocessor dist/bin/dmgInstallHelper-Info.plist,-Fsubstitution -DMOZ_MACBUNDLE_ID='$(MOZ_MACBUNDLE_ID)' -DMOZ_SMAUTHORIZEDCLIENTS_REQUIREMENTS='$(MOZ_SMAUTHORIZEDCLIENTS_REQUIREMENTS)' $(srcdir)/Info.plist.in -o $(DIST)/bin/dmgInstallHelper-Info.plist)
endif
