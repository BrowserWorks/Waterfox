From 2f46629097983db35aabe85f7b1b4d82997ce9a2 Mon Sep 17 00:00:00 2001
From: Luca Versari <veluca93@gmail.com>
Date: Wed, 2 Sep 2026 11:56:15 +0200
Subject: [PATCH] Fix whitepoint check


Local backport scope: production changes only. Upstream regression tests,
fixtures, and test-only harness changes are intentionally omitted. The
original commit message above describes the full upstream change.

diff --git a/jxl/src/headers/color_encoding.rs b/jxl/src/headers/color_encoding.rs
--- a/jxl/src/headers/color_encoding.rs
+++ b/jxl/src/headers/color_encoding.rs
@@ -3,7 +3,7 @@
 // Use of this source code is governed by a BSD-style
 // license that can be found in the LICENSE file.
 
-use crate::api::primaries_to_xyz;
+use crate::api::{adapt_to_xyz_d50, primaries_to_xyz};
 use crate::{bit_reader::BitReader, error::Error, headers::encodings::*};
 use jxl_macros::UnconditionalCoder;
 use num_derive::FromPrimitive;
@@ -46,6 +46,17 @@ pub enum WhitePoint {
     DCI = 11,
 }
 
+impl WhitePoint {
+    pub fn to_xy_coords(&self, custom: &CustomXY) -> (f32, f32) {
+        match self {
+            WhitePoint::D65 => (0.3127, 0.3290),
+            WhitePoint::E => (1.0 / 3.0, 1.0 / 3.0),
+            WhitePoint::DCI => (0.314, 0.351),
+            WhitePoint::Custom => custom.as_f32_coords(),
+        }
+    }
+}
+
 #[allow(clippy::upper_case_acronyms)]
 #[derive(UnconditionalCoder, Copy, Clone, PartialEq, Debug, FromPrimitive)]
 pub enum Primaries {
@@ -203,6 +214,10 @@ impl ColorEncoding {
         {
             return Err(Error::InvalidColorEncoding);
         }
+        let (wx, wy) = self.white_point.to_xy_coords(&self.white);
+        if self.white_point == WhitePoint::Custom {
+            adapt_to_xyz_d50(wx, wy)?;
+        }
         if self.primaries == Primaries::Custom {
             primaries_to_xyz(
                 self.custom_primaries[0].as_f32_coords().0,
@@ -211,10 +226,10 @@ impl ColorEncoding {
                 self.custom_primaries[1].as_f32_coords().1,
                 self.custom_primaries[2].as_f32_coords().0,
                 self.custom_primaries[2].as_f32_coords().1,
-                self.white.as_f32_coords().0,
-                self.white.as_f32_coords().1,
+                wx,
+                wy,
             )?;
         }
         Ok(())
     }
 }
